# PRAGATI AI - Configuration
PROJECT_NAME="PRAGATI AI"
DATABASE_URL="sqlite:///./pragati_ai.db"

# AI Provider ("fallback", "gemini", "openai")
AI_PROVIDER="fallback"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Multi-Signal Matching Weights (Must sum to 1.0)
WEIGHT_SEMANTIC=0.50
WEIGHT_DISCIPLINE=0.15
WEIGHT_ENTITY=0.15
WEIGHT_LOCATION=0.10
WEIGHT_TEMPORAL=0.10

# Confidence Routing Thresholds
THRESHOLD_HIGH=0.70
THRESHOLD_MEDIUM=0.48
THRESHOLD_UNMATCHED=0.32
MARGIN_HIGH_CONFIDENCE=0.08
